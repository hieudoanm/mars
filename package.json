{
  "name": "@mars/workspace",
  "version": "0.0.1",
  "private": true,
  "description": "Project Mars",
  "license": "MIT",
  "author": {
    "name": "Hieu Doan",
    "email": "hieu.doan.professional@gmail.com",
    "url": "https://hieudoanm.github.io"
  },
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format",
    "landing:build": "turbo run build --filter=@mars/landing",
    "landing:check": "turbo run check --filter=@mars/landing",
    "landing:dev": "turbo run dev --filter @mars/landing",
    "desktop:build": "turbo run build --filter=@mars/desktop",
    "desktop:e2e": "turbo run test:e2e --filter=@mars/desktop",
    "vscode:compile": "turbo run check --filter=mars-vscode",
    "vscode:package": "turbo run package --filter=mars-vscode",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,md,mdx,css,scss,html,yml,yaml}": "prettier --cache --write",
    "!(vendor)/**/*.rs": "rustfmt --edition 2024"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.3",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.13"
  }
}
