{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Mars",
  "version": "0.0.1",
  "identifier": "io.github.hieudoanm.mars",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Project Mars",
        "width": 1280,
        "height": 860,
        "minWidth": 840,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Project Mars interactive notebook",
    "longDescription": "Project Mars is a Rust-powered interactive notebook platform for code, Markdown, math, and rich outputs.",
    "copyright": "Copyright (c) 2026 hieudoanm",
    "publisher": "hieudoanm",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
