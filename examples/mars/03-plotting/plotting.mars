  "cells": [
    {
      "id": "plotting-intro",
      "cell_type": "markdown",
      "source": "# Plotting with Plotters\n\nPlotters renders vector figures for notebook output, similar to matplotlib in Jupyter. Mars displays the SVG MIME representation directly.",
      "metadata": {},
      "outputs": []
    },
    {
      "id": "plotting-import",
      "cell_type": "code",
      "source": "use plotters::prelude::*;",
      "metadata": {},
      "execution_count": 1,
      "outputs": []
    },
    {
      "id": "plotting-sine",
      "cell_type": "code",
      "source": "let figure = plotters::evcxr::evcxr_figure((640, 480), |root| {\n    root.fill(&WHITE)?;\n\n    let mut chart = ChartBuilder::on(&root)\n        .caption(\"Sine wave\", (\"sans-serif\", 28))\n        .margin(12)\n        .x_label_area_size(30)\n        .y_label_area_size(36)\n        .build_cartesian_2d(0.0_f64..10.0, -1.0_f64..1.0)?;\n\n    chart.configure_mesh().draw()?;\n    chart.draw_series(LineSeries::new(\n        (0..=200).map(|step| {\n            let x = step as f64 / 20.0;\n            (x, x.sin())\n        }),\n        &RED,\n    ))?;\n\n    Ok(())\n});\n\nfigure.evcxr_display();",
      "metadata": {},
      "execution_count": 2,
      "outputs": [
        {
          "type": "mime_bundle",
          "data": {
            "image/svg+xml": "<svg width=\"640\" height=\"480\" viewBox=\"0 0 640 480\" xmlns=\"http://www.w3.org/2000/svg\">\n<rect x=\"0\" y=\"0\" width=\"640\" height=\"480\" opacity=\"1\" fill=\"#FFFFFF\" stroke=\"none\"/>\n<text x=\"320\" y=\"17\" dy=\"0.76em\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"22.580645161290324\" opacity=\"1\" fill=\"#000000\">\nSine wave\n</text>\n<line opacity=\"0.1\" stroke=\"#000000\" stroke-width=\"1\" x1=\"48\" y1=\"437\" x2=\"48\" y2=\"44\"/>\n<line opacity=\"0.1\" stroke=\"#000000\" stroke-width=\"1\" x1=\"53\" y1=\"437\" x2=\"53\" y2=\"44\"/>\n<line opacity=\"0.1\" stroke=\"#000000\" stroke-width=\"1\" x1=\"59\" y1=\"437\" x2=\"59\" y2=\"44\"/>\n<line opacity=\"0.1\" stroke=\"#000000\" stroke-width=\"1\" x1=\"65\" y1=\"437\" x2=\"65\" y2=\"44\"/>\n<line opacity=\"0.1\" stroke=\"#000000\" stroke-width=\"1\" x1=\"71\" y1=\"437\" x2=\"71\" y2=\"44\"/>\n<line opacity=\"0.1\" stroke=\"#000000\" stroke-width=\"1\" x1=\"76\" y1=\"437\" x2=\"76\" y2=\"44\"/>\n<line opacity=\"0.1\" stroke=\"#000000\" stroke-width=\"1\" x1=\"82\" y1=\"437\" x2=\"82\" y2=\"44\"/>\n<line opacity=\"0.1\" stroke=\"#000000\" stroke-width=\"1\" x1=\"88\" y1=\"437\" x2=\"88\" y2=\"44\"/>\n<line opacity=\"0.1\" stroke=\"#000000\" stroke-width=\"1\" x1=\"94\" y1=\"437\" x2=\"94\" y2=\"44\"/>\n<line opacity=\"0.1\" stroke=\"#000000\" stroke-width=\"1\" x1=\"100\" y1=\"437\" x2=\"100\" y2=\"44\"/>\n<line opacity=\"0.1\" stroke=\"#000000\" stroke-width=\"1\" x1=\"105\" y1=\"437\" x2=\"105\" y2=\"44\"/>\n<line opacity=\"0.1\" stroke=\"#000000\" stroke-width=\"1\" x1=\"111\" y1=\"437\" x2=\"111\" y2=\"44\"/>\n<line opacity=\"0.1\" stroke=\"#000000\" stroke-width=\"1\" x1=\"117\" y1=\"437\" x2=\"117\" y2=\"44\"/>\n<line opacity=\"0.1\" stroke=\"#000000\" stroke-width=\"1\" x1=\"123\" y1=\"437\" x2=\"123\" y2=\"44\"/>\n<line opacity=\"0.1\" stroke=\"#000000\" stroke-width=\"1\" x1=\"129\" y1=\"437\" x2=\"129\" y2=\"44\"/>\n<line opacity=\"0.1\" str