{
  "format_version": 2,
  "metadata": {
    "title": "Linear regression",
    "language": "rust"
  },
  "cells": [
    {
      "id": "regression-intro",
      "cell_type": "markdown",
      "source": "# Linear regression\n\nCompute a simple least-squares slope.",
      "metadata": {}
    },
    {
      "id": "regression-data",
      "cell_type": "code",
      "source": "let x = vec![1.0_f64, 2.0, 3.0, 4.0];\nlet y = vec![2.0_f64, 4.1, 5.9, 8.2];",
      "metadata": {},
      "execution_count": null,
      "outputs": [
        {
          "type": "text",
          "text": "Executed:\nlet x = vec![1.0_f64, 2.0, 3.0, 4.0];\nlet y = vec![2.0_f64, 4.1, 5.9, 8.2];"
        }
      ]
    },
    {
      "id": "regression-result",
      "cell_type": "code",
      "source": "let x_mean = x.iter().sum::<f64>() / x.len() as f64;\nlet y_mean = y.iter().sum::<f64>() / y.len() as f64;\nlet slope = x.iter().zip(&y).map(|(x, y)| (x - x_mean) * (y - y_mean)).sum::<f64>() / x.iter().map(|x| (x - x_mean).powi(2)).sum::<f64>();\nslope",
      "metadata": {},
      "execution_count": null,
      "outputs": [
        {
          "type": "text",
          "text": "Executed:\nlet x_mean = x.iter().sum::<f64>() / x.len() as f64;\nlet y_mean = y.iter().sum::<f64>() / y.len() as f64;\nlet slope = x.iter().zip(&y).map(|(x, y)| (x - x_mean) * (y - y_mean)).sum::<f64>() / x.iter().map(|x| (x - x_mean).powi(2)).sum::<f64>();\nslope"
        }
      ]
    }
  ]
}