1 0 0 1 54 699.89 Tm (let mut bias: f64 = 0.0;) Tj
1 0 0 1 54 688.89 Tm () Tj
1 0 0 1 54 677.89 Tm (let epochs: usize = 1000;) Tj
1 0 0 1 54 666.89 Tm (let learning_rate: f64 = 0.01;) Tj
1 0 0 1 54 655.89 Tm (let n: usize = x_train.len\(\);) Tj
1 0 0 1 54 644.89 Tm () Tj
1 0 0 1 54 633.89 Tm (for _ in 0..epochs {) Tj
1 0 0 1 54 622.89 Tm (    let mut grad_w: Vec<f64> = vec![0.0; n_features];) Tj
1 0 0 1 54 611.89 Tm (    let mut grad_b: f64 = 0.0;) Tj
1 0 0 1 54 600.89 Tm (    ) Tj
1 0 0 1 54 589.89 Tm (    for i in 0..n {) Tj
1 0 0 1 54 578.89 Tm (        let z: f64 = w.iter\(\).zip\(&x_train[i]\).map\(|\(&w_j, &x_j\)| w_j * x_j\).sum::<f64>\(\) + bias;) Tj
1 0 0 1 54 567.89 Tm (        let pred: f64 = 1.0 / \(1.0 + \(-z\).exp\(\)\);) Tj
1 0 0 1 54 556.89 Tm (        let error: f64 = pred - y_train[i] as f64;) Tj
1 0 0 1 54 545.89 Tm (        grad_b += error;) Tj
1 0 0 1 54 534.89 Tm (        for j in 0..n_features {) Tj
1 0 0 1 54 523.89 Tm (            grad_w[j] += error * x_train[i][j];) Tj
1 0 0 1 54 512.89 Tm (        }) Tj
1 0 0 1 54 501.89 Tm (    }) Tj
1 0 0 1 54 490.89 Tm (    ) Tj
1 0 0 1 54 479.89 Tm (    for j in 0..n_features {) Tj
1 0 0 1 54 468.89 Tm (        w[j] -= learning_rate * grad_w[j] / n as f64;) Tj
1 0 0 1 54 457.89 Tm (    }) Tj
1 0 0 1 54 446.89 Tm (    bias -= learning_rate * grad_b / n as f64;) Tj
1 0 0 1 54 435.89 Tm (}) Tj
