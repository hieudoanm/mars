{
  "name": "mars-vscode",
  "displayName": "Mars Notebooks",
  "description": "Language support and preview commands for .mars notebooks.",
  "version": "0.0.1",
  "publisher": "project-mars",
  "icon": "assets/png/mars-logo.png",
  "license": "MIT",
  "packageManager": "pnpm@12.23.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hieudoanm/mars"
  },
  "engines": {
    "vscode": "1.148.0"
  },
  "categories": [
    "Programming Languages",
    "Notebooks"
  ],
  "activationEvents": [
    "onNotebook:mars-notebook",
    "onLanguage:mars",
    "onCommand:mars.exportHtml",
    "onCommand:mars.exportMarkdown",
    "onCommand:mars.preview",
    "onCommand:mars.runNotebook",
    "onCommand:mars.openCell",
    "onCommand:mars.checkCell",
    "onCommand:mars.checkNotebook",
    "onCommand:mars.interruptExecution",
    "onCommand:mars.sendKernelInput",
    "onCommand:mars.createCheckpoint",
    "onCommand:mars.restoreCheckpoint"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "notebooks": [
      {
        "type": "mars-notebook",
        "displayName": "Mars Notebook",
        "selector": [
          {
            "filenamePattern": "*.mars"
          }
        ],
        "priority": "default"
      }
    ],
    "iconThemes": [
      {
        "id": "mars-icons",
        "label": "Project Mars File Icons",
        "path": "./icons/mars-icon-theme.json"
      }
    ],
    "languages": [
      {
        "id": "mars",
        "aliases": [
          "Mars Notebook"
        ],
        "extensions": [
          ".mars"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./assets/png/mars-file-logo.png",
          "dark": "./assets/png/mars-file-logo.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "mars",
        "scopeName": "source.mars",
        "path": "./syntaxes/mars.tmLanguage.json",
        "embeddedLanguages": {
          "source.rust": "rust",
          "text.html.markdown": "markdown"
        }
      }
    ],
    "commands": [
      {
        "command": "mars.exportHtml",
        "title": "Project Mars: Export Notebook to HTML"
      },
      {
        "command": "mars.exportMarkdown",
        "title": "Project Mars: Export Notebook to Markdown"
      },
      {
        "command": "mars.preview",
        "title": "Project Mars: Preview Notebook"
      },
      {
        "command": "mars.runNotebook",
        "title": "Project Mars: Run Notebook"
      },
      {
        "command": "mars.openCell",
        "title": "Project Mars: Go to Cell"
      },
      {
        "command": "mars.createNotebook",
        "title": "Project Mars: Create New Notebook"
      },
      {
        "command": "mars.restartKernel",
        "title": "Project Mars: Restart Kernel"
      },
      {
        "command": "mars.interruptExecution",
        "title": "Project Mars: Interrupt Execution"
      },
      {
        "command": "mars.checkCell",
        "title": "Project Mars: Check Cell"
      },
      {
        "command": "mars.checkNotebook",
        "title": "Project Mars: Check Notebook"
      },
      {
        "command": "mars.sendKernelInput",
        "title": "Project Mars: Send Input to Kernel"
      },
      {
        "command": "mars.createCheckpoint",
        "title": "Project Mars: Create Checkpoint"
      },
      {
        "command": "mars.restoreCheckpoint",
        "title": "Project Mars: Restore Checkpoint"
      },
      {
        "command": "mars.refreshVariables",
        "title": "Project Mars: Refresh Variables"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mars",
          "title": "Project Mars",
          "icon": "assets/png/mars-logo.png"
        }
      ]
    },
    "views": {
      "mars": [
        {
          "id": "mars.variables",
          "name": "Kernel Variables",
          "icon": {
            "light": "./assets/svg/mars-variables-light.svg",
            "dark": "./assets/svg/mars-variables-dark.svg"
          }
        }
      ]
    },
    "configuration": {
      "title": "Mars Notebooks",
      "properties": {
        "mars.cliPath": {
          "type": "string",
          "default": "mars",
          "description": "Path to the Project Mars CLI executable."
        },
        "mars.previewAfterExport": {
          "type": "boolean",
          "default": true,
          "description": "Open the generated HTML or Markdown file after exporting a notebook."
        },
        "mars.runArguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional arguments passed to `mars notebook run`."
        },
        "mars.executionTimeout": {
          "type": "number",
          "default": 30000,
          "description": "Timeout in milliseconds for cell execution. Rust compilation can be slow, so increase this if needed."
        },
        "mars.runtime": {
          "type": "string",
          "enum": [
            "replay",
            "evcxr"
          ],
          "default": "replay",
          "description": "Runtime backend passed to `mars kernel serve`. Use `evcxr` for plotters/evcxr display output; the Project Mars CLI must be built with the experimental-evcxr feature."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "mars.exportHtml",
          "when": "resourceLangId == mars || resourceExtname == .mars",
          "group": "navigation"
        },
        {
          "command": "mars.exportMarkdown",
          "when": "resourceLangId == mars || resourceExtname == .mars",
          "group": "navigation"
        }
      ],
      "notebook/toolbar": [
        {
          "command": "mars.exportMarkdown",
          "when": "notebookType == mars-notebook",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "mars.createNotebook",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mars.createNotebook",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "!notebookEditorFocused"
      }
    ]
  },
  "scripts": {
    "format": "prettier --cache --write .",
    "format:check": "prettier --cache --check .",
    "build": "npm run compile",
    "typecheck": "npm run compile",
    "compile": "tsc -p .",
    "package": "npm run compile && node -e \"require('fs').mkdirSync('vsix',{recursive:true})\" && vsce package --out vsix/mars-vscode.vsix",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.10",
    "@types/vscode": "1.146.0",
    "@vitest/coverage-v8": "5.1.2",
    "@vscode/vsce": "4.1.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  }
}
